    categories: [
        {
            name: "Red raspberries, summer-bearing",
            description: "Source lists these by ripening date from earliest to latest"
        },
        {
            name: "Red raspberries, everbearing",
            description:
                "Primocane-fruiting red raspberries. Source lists these by fall ripening date from earliest to latest"
        },
        {
            name: "Yellow raspberries, everbearing",
            description: "Primocane-fruiting yellow raspberries"
        },
        {
            name: "Purple raspberries, summer-bearing",
            description:
                "Source says purple raspberries are generally not hardy enough for commercial viability in most of Maine"
        },
        {
            name: "Black raspberries",
            description:
                "Source says black raspberries can winter-kill to the snowline at -10 degrees F and are disease susceptible; not considered commercially viable in Maine"
        },
        {
            name: "Blackberries, thorny",
            description:
                "Erect thorny blackberries are sensitive to -10 degrees F or colder and are not recommended for commercial production in Maine"
        },
        {
            name: "Blackberries, thornless",
            description:
                "Thornless blackberries need staking or trellising, are sensitive to winter injury, and are not considered commercially viable for Maine"
        },
        {
            name: "Blackberries, everbearing",
            description:
                "Source says newer everbearing blackberries ripen their fall crop too late to be practical in Maine and are not recommended"
        }
    ],
