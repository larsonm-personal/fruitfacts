            name: "Heritage",
            category: "Red raspberries, everbearing",
            harvest_time_unparsed: "relatively late fall crop",
            description:
                "From New York. Relatively late fall crop, too late except in southern Maine. Tall rugged thorny canes. Very high yielding. Medium fruit with good color, flavor, and firmness. Not recommended where season is short"
        },
        {
            type: "Raspberry",
            name: "Anne",
            category: "Yellow raspberries, everbearing",
