{
    title: "Raspberry and Blackberry Varieties for Maine",
    author: "David T. Handley, vegetable and small fruit specialist, University of Maine Cooperative Extension",
    description:
        "UMaine bramble variety guide. The source emphasizes site testing, intended use, hardiness, productivity, disease susceptibility, fruit quality, and ripening time for Maine. It names Boyne, Killarney, Reveille, Nova, Polana, Joan J, Royalty, Jewel, and Illini as best home-garden choices.",
    url: "https://extension.umaine.edu/publications/2172e/",
    published: "1995, 2009, 2020",
    reviewed: "2024",
