{
    title: "Growing Blackberries in Colorado Gardens",
    author: "David Whiting, CSU Extension, retired and Merrill Kingsbury, CSU Extension",
    description:
        "Colorado Master Gardener GardenNotes blackberry guide. The source gives Colorado-oriented guidance for blackberry types, winter-hardiness limitations, primocane-fruiting and semi-erect cultivar suggestions, blackberry-red raspberry hybrids, planting, trellising, and pruning",
    url: "https://cmg.extension.colostate.edu/Gardennotes/762.pdf",
    published: "August 2018",
    reviewed: "March 2023",
    accessed: "Jun 2026",
    type: "state extension guide",
    thumbnail: "pdf",
    needs_help: true, // todo - review blackberry hybrid names before clearing
