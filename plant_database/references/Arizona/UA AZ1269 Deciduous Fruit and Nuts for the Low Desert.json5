    plants: [
        {
            type: "Apple",
            name: "Anna",
            category: "Low-desert apple varieties",
            description: "Remarkable fruit for mild-winter climates in Southern Arizona. Heavy crops of sweet, crisp, flavorful apples even in low desert. Fresh or cooked. Keeps 2 months in refrigerator. Chilling requirement 200 hours. Self-fruitful or pollinated by Dorsett Golden or Ein shemer"
        },
        {
            type: "Apple",
            name: "Beverly Hills",
            category: "Low-desert apple varieties",
            description: "Produces a pale yellow medium sized fruit. Chilling requirement 300 hours. Self-fruitful"
        },
        {
            type: "Apple",
            name: "Ein Shemer",
            category: "Low-desert apple varieties",
            description: "Heavy-bearing, very low chilling requirement of 100 hours. Sweet yellow apples in early summer (June in the low desert). Excellent pollenizer for Anna. Self- fruitful. Source names this as Ein shemer"
        },
        {
            type: "Apple",
            name: "Fuji",
            category: "Low-desert apple varieties",
            description: "Recently introduced from Japan, has quickly become California's favorite apple. Sweet, very crisp and flavorful, excellent keeper. Dull reddish-orange skin, sometimes russeted. Chilling requirement listed as 600 hours, but preliminary testing in the low desert indicate that it may be less. Self-fruitful"
        },
        {
            type: "Apple",
            name: "Gala",
            category: "Low-desert apple varieties",
            description: "Wonderful dessert apple from New Zealand. Crisp, nice blend of sweetness and tartness, rich flavor. Skin reddish-orange over yellow. Chilling requirement listed as 500-600 hours, preliminary testings suggest it maybe less. Self-fruitful"
        },
        {
            type: "Apple",
            name: "Golden Dorsett",
            category: "Low-desert apple varieties",
            description: "Outstanding sweet apple for warm winter areas. Firm, very flavorful, sweet like Golden Delicious. Productive throughout the low desert. Good early season sweet apple. Chilling requirement of 100 hours. Self-fruitful"
        },
        {
            type: "Apple",
            name: "Gordon",
            category: "Low-desert apple varieties",
            description: "Produces a reddish-green fruit for fresh use and cooking. Chilling requirement, 400 hours. Self-fruitful"
        },
        {
            type: "Apricot",
            name: "Castlebrite",
            category: "Low-desert apricot varieties",
            description: "Firm and juicy. Good flavor when fully ripe, otherwise somewhat tart. Good size. Bright orange with red blush. 450 chill hours. Self-fruitful"
        },
        {
            type: "Apricot",
            name: "Gold Kist",
            category: "Low-desert apricot varieties",
            description: "Excellent backyard apricot for warm winter climates. Freestone, very good quality. Heavy bearing. Early harvest, late May to early June. Requires 300 chill hours. Self-fruitful"
        },
        {
            type: "Apricot",
            name: "Katy",
            category: "Low-desert apricot varieties",
            description: "Large, all purpose flavorful freestone. Tree ripe fruit is subacid (not tart). A favorite apricot for warm-winter climates. Early harvest, late May to early June. Requires 400 chill hours. Self-fruitful"
        },
        {
            type: "Apricot",
            name: "Modesto",
            category: "Low-desert apricot varieties",
            description: "Commercially grown for shipping. 300-400 hours chilling. Self-fruitful"
        },
        {
            type: "Apricot",
            name: "Patterson",
            category: "Low-desert apricot varieties",
            description: "A vigorous tree. Fruit are medium to large in size with good firm, modestly flavorful flesh. Good for freezing, drying, and canning. Requires 500 chill hours. Self-fruitful"
        },
        {
            type: "Apricot",
            name: "Royal Rosa",
            category: "Low-desert apricot varieties",
            description: "Extremely vigorous, more disease tolerant than other apricots. Bears young and heavy. Especially nice fruit: sweet, low acid, fine flavor. Very early harvest (early-to-mid May). Excellent backyard apricot. Requires 500 chill hours. Self-fruitful"
        },
        {
            type: "Fig",
            name: "Black Mission",
            category: "Low-desert fig varieties",
            description: "Popular and flavorful for eating fresh or dried. Medium to large pear-shaped fruit has skin which is black-purple and strawberry-colored flesh. Tree is large and long lived. Well adapted to elevations below 2,000 feet"
        },
        {
            type: "Fig",
            name: "Brown Turkey",
            category: "Low-desert fig varieties",
            description: "Sweet tasting and best eaten fresh. Bell shaped medium to large fruit has browish- purple skin with pink flesh. Tree is large and best adapted to 2,000 - 3,000 feet. Not as prolific as Mission"
        },
        {
            type: "Fig",
            name: "Conadria (White)",
            category: "Low-desert fig varieties",
            description: "Mild and sweet with whitish-pink flesh. Large fruit with cream to light green colored skin. Good, eaten fresh or dried. Tolerates heat well"
        },
        {
            type: "Fig",
            name: "White Kadota",
            category: "Low-desert fig varieties",
            description: "Good, fresh or dried, suitable for canning. Fruit is medium sized with yellow skin. Flesh is amber with few seeds. Hot weather aids in ripening"
        },
        {
            type: "Peach",
            name: "Bonanza Miniature",
            category: "Low-desert peach varieties",
            description: "Popular yellow freestone - large fruit is sweet, low in acid, with a mild, refreshing flavor. Mid-to-late May in low desert climates. Five- to six-foot tree. Chilling requirement very low, 250 hours or less. Self-fruitful"
        },
        {
            type: "Peach",
            name: "August Pride",
            category: "Low-desert peach varieties",
            description: "Large, all-purpose yellow freestone for mild-winter climates. Sweet, aromatic, rich flavor, one of the best. Chilling requirement less than 300 hours. Selffruitful"
        },
        {
            type: "Peach",
            name: "Babcock",
            category: "Low-desert peach varieties",
            description: "Long-time favorite white-fleshed freestone. Sweet and juicy, aromatic, low in acid. Very high-scoring in taste test. Chilling requirement of 250-300 hours. Self-fruitful"
        },
        {
            type: "Peach",
            name: "Desertgold",
            category: "Low-desert peach varieties",
            description: "Very early ripening: mid-May in Arizona. Tree-ripened fruit has good flavor and sweetness for such an early variety. Yellow Clingstone. Heavy bearing. Chilling requirement of 250 hours. Self-fruitful. Source names this as Desert Gold"
        },
        {
            type: "Peach",
            name: "Desert Red",
            category: "Low-desert peach varieties",
            description: "An excellent quality, firm cling peach that has good color. Produces large fruit when thinned and girdled. Chilling requirement of 200-300 hours. Self-fruitful"
        },
        {
            type: "Peach",
            name: "Earligrande",
            category: "Low-desert peach varieties",
            description: "Medium size, low-chill peach from Gulf Coast Texas. Yellow semi-freestone. Very early (May). Successful in Arizona and similar climates. Chilling requirement of 275 hours. Self-fruitful"
        },
        {
            type: "Peach",
            name: "Eva's Pride",
            category: "Low-desert peach varieties",
            description: "Delicious, fine-flavored peach with very low-chilling requirement. Medium- to large-sized yellow freestone. Ripens early-to-late May. Chilling requirement of 100-200 hours. Self-fruitful"
        },
        {
            type: "Peach",
            name: "Flordaking",
            category: "Low-desert peach varieties",
            description: "High quality early season peach. Large, firm, flavorful semi-freestone, very sweet when fully ripe. MidMay in warm winter climates. Chilling requirement 450 hours or less. Self-fruitful"
        },
        {
            type: "Peach",
            name: "Flordaprince",
            category: "Low-desert peach varieties",
            description: "From Florida, successfully grown in Arizona. Yellow, semi-cling, larger fruit than Desert Gold, more tolerant of desert heat. Ripens late April to early May in Arizona. Very good quality when tree-ripe. Chilling requirement of 150 hours. Self-fruitful"
        },
        {
            type: "Peach",
            name: "Flordagrande",
            category: "Low-desert peach varieties",
            description: "Excellent yellow-fleshed semi-freestone peach. Flesh will have some red coloration at maturity. Requires less than 100 chill hours"
        },
        {
            type: "Peach",
            name: "May Pride",
            category: "Low-desert peach varieties",
            description: "Very early-ripening, semi-freestone peach for warm winter climates. Ripens in May with Desert Gold. Delicious, sweet and tangy fruit. Very large for such an early peach. Large, showy pink blossoms. Chilling requirement 175 - 200 hours. Self-fruitful"
        },
        {
            type: "Peach",
            name: "Mid-Pride",
            category: "Low-desert peach varieties",
            description: "Best yellow freestone for warm winter climates. Mid-season peach. Chilling requirement of 250 hours. Self-fruitful"
        },
        {
            type: "Peach",
            name: "TropicBeauty",
            category: "Low-desert peach varieties",
            description: "Excellent quality yellow flesh, firm freestone peach. Produces a large fruit when thinned and girdled properly. Chilling requirement of 100-200 hours. Good for the low desert. Self-fruitful. Ripens early May. Source names this as Tropic Beauty"
        },
        {
            type: "Peach",
            name: "TropicSnow",
            category: "Low-desert peach varieties",
            description: "Medium-sized fruit. Skin is white with red blush. White sweet flesh. Good flavor. Freestone. Ripens early May. Chilling requirement 175-200 hours. Self-fruitful. Source names this as Tropic Snow"
        },
        {
            type: "Peach",
