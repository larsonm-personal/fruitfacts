        {
            type: "Almond",
            name: "Nonpareil Almond",
            category: "Low-desert almond varieties",
            description: "No. 1 commercial almond, the standard of quality. Inter-fruitful with All-In-One and Neplus. Chilling requirement 400 hours. Pollenizer required"
        },
