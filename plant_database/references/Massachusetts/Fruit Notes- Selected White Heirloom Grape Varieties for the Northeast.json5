{
    title: "Selected White Heirloom Grape Varieties for the Northeast",
    author: "J. Stephen Casscles",
    description: "Fruit Notes Volume 83, Number 4, Fall 2018 article describing white heirloom grape varieties evaluated at Cedar Cliff Farm in Athens, New York",
    url: "http://www.umassfruitnotes.com/v83n4/a4.pdf",
