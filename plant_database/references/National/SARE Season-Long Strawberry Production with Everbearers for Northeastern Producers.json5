{
    title: "SARE Season-Long Strawberry Production with Everbearers for Northeastern Producers",
    author: "Willie Lantz, Harry Swartz, Kathleen Demchak, and Sherry Frick",
    description: "SARE and University of Maryland Extension guide to season-long everbearing strawberry production for Northeastern producers, including cultivar descriptions and Mid-Atlantic recommendation notes",
    url: "https://www.sare.org/resources/season-long-strawberry-production-with-everbearers-for-northeastern-producers/",
    publication_number: "EB 401",
