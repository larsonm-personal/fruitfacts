        {
            name: "American persimmon cultivars for northern areas",
            description: "J. C. McDaniel discussed these American persimmon cultivars for northern areas in Fruit Varieties Journal 27:94-96"
        },
        {
            name: "American persimmon cultivars tried in Illinois but not currently recommended",
            description: "J. C. McDaniel said these American persimmon cultivars had been tried in Illinois but were not then recommended for one reason or another"
