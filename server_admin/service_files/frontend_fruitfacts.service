[Unit]
Description=fruitfacts frontend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Restart=on-failure
RestartSec=10
WorkingDirectory=/var/www/fruitfacts-releases/current/frontend
# Must match command -v node in the deployment user's environment.
ExecStart=/usr/local/bin/node /var/www/fruitfacts-releases/current/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
