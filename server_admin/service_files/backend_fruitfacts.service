[Unit]
Description=fruitfacts backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Restart=on-failure
RestartSec=20
# Keep the existing SQLite database in its original directory.
WorkingDirectory=/var/www/fruitfacts/backend
ExecStart=/var/www/fruitfacts-releases/current/backend/harvest-chart-server

[Install]
WantedBy=multi-user.target
