# Generated by Cargo
# will have compiled files and executables
debug/
target/

# built binary moved up to this level
harvest-chart-server

# Keep Cargo.lock tracked so CI and rebuilds use the tested dependency versions.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

database.sqlite3
database.sqlite3-journal

# for pdfium dlls, usually named pdfium.dll
*.dll

/.env
